ode":"","rawMeta":{"type":4},"type":"literal"}},"left":{},"name":"temperature","right":{}},{"input":{"type":"integer","value":{"content":"1024","dependencies":{"variables":null},"inputMode":"","rawMeta":{"type":2},"type":"literal"}},"left":{},"name":"maxTokens","right":{}},{"input":{"type":"integer","value":{"content":"2","dependencies":{"variables":null},"inputMode":"","rawMeta":{"type":2},"type":"literal"}},"left":{},"name":"responseFormat","right":{}},{"input":{"type":"string","value":{"content":"DeepSeek-V3","dependencies":{"variables":null},"inputMode":"","rawMeta":{"type":1},"type":"literal"}},"left":{},"name":"modleName","right":{}},{"input":{"type":"integer","value":{"content":"1738675210","dependencies":{"variables":null},"inputMode":"","rawMeta":{"type":2},"type":"literal"}},"left":{},"name":"modelType","right":{}},{"input":{"type":"string","value":{"content":"balance","dependencies":{"variables":null},"inputMode":"","rawMeta":{"type":1},"type":"literal"}},"left":{},"name":"generationDiversity","right":{}},{"input":{"type":"string","value":{"content":"{{input}}","dependencies":{"variables":null},"inputMode":"","rawMeta":{"type":1},"type":"literal"}},"left":{},"name":"prompt","right":{}},{"input":{"type":"boolean","value":{"content":false,"dependencies":{"variables":null},"inputMode":"","rawMeta":{"type":3},"type":"literal"}},"left":{},"name":"enableChatHistory","right":{}},{"input":{"type":"integer","value":{"content":"3","dependencies":{"variables":null},"inputMode":"","rawMeta":{"type":2},"type":"literal"}},"left":{},"name":"chatHistoryRound","right":{}},{"input":{"type":"string","value":{"content":"# 角色\n你是一位专注于情绪共鸣图文视频工作流，擅长创作彩色简笔画风格插画提示词的创作者。能够根据用户给定{{input}}内容，结合{{output}}人物形象，生成与之匹配的、不能有遗漏的、充满阳光明亮治愈系的场景插画提示词。插画具备卡通风格、治愈系特点以及生动童趣的手绘笔触。\n\n## 技能\n### 技能 1: 根据内容生成插画提示词\n1.  深入分析用户给定的每个{{input}}文本内容，精准提炼其中的情感、氛围和含义，并将其充分融入到后续构建的插画场景中。\n2.  **固定画面主体为{{output}}，其形象描述必须严格使用以下文本：** \"**{{output}}**\"。\n3.  围绕这位固定的{{output}}，根据**每个{{input}}内容提炼出的情感和含义**，创意构建与之匹配的、充满阳光、明亮、治愈系的场景和老爷爷的动作。确保构建的场景新颖且贴合当前文本主题，避免与过往示例（固定的形象描述本身除外）重复。\n4.  确保**每个生成的提示词**都包含“彩色简笔画”“阳光明亮的治愈系插画”“清新亮丽的色调和流畅的线条”“生动童趣手绘笔触”这些描述风格的词汇。\n5.  **对于用户提供的每一个{{input}}文本，生成一个对应的完整的插画提示词。输出提示词的数量必须与输入的文本数量一致，不能有任何遗漏或增减。只需要一个提示词输出一个描述词。**\n6.  生成的提示词中不要包含任何文字元素。\n\n## 限制:\n- 严格杜绝输出与过往相似或重复内容，每个输出都必须具备独特性。 \n- 生成的提示词中严禁出现文字\n-   **生成的提示词数量必须严格对应输入的文案数量，禁止删减或缺少任何一个。**\n-   **每个生成的提示词都必须以{{output}}形象描述开头：** \"**{{output}}**\"。在此基础上，描述与当前输入文案内容紧密关联的治愈场景和老奶奶的具体动作。\n-   生成的提示词画面必须是阳光明亮、充满治愈感的，严禁输出过暗或负面情绪的画面。\n-   每个生成的提示词描述应丰富具体，长度不得低于100字。\n-   **对于每一个输入的文本，生成一个对应的、独立的提示词。** 每个提示词必须包含固定的老奶奶形象描述以及所有指定的风格描述词汇。\n-   提示词描述要简洁明了，突出关键元素，清晰展现场景、老奶奶的动作与给定文案内容的关联性，尤其要体现出阳光明亮的感觉。\n-   严格杜绝输出的**场景和动作描述**与针对其他文案生成的场景重复，每个输出的**场景**都必须具备独特性（固定的形象描述本身除外）。\n-   生成的提示词中严禁出现任何可识别的文字。\n","dependencies":{"variables":null},"inputMode":"","rawMeta":{"type":1},"type":"literal"}},"left":{},"name":"systemPrompt","right":{}}],"settingOnError":{"processType":1,"switch":false,"timeoutMs":600000}},"nodeMeta":{"description":"调用大语言模型,使用变量和提示词生成回复","icon":"https://lf3-static.bytednsdoc.com/obj/eden-cn/dvsmryvd_avi_dvsm/ljhwZthlaukjlkulzlp/icon/icon-LLM-v2.jpg","title":"图片提示词"},"outputs":[{"input":{},"name":"output","required":false,"type":"string"}],"settings":null,"version":"3"},"edges":null,"id":"849520","meta":{"canvasPosition":{"x":0,"y":0},"defaultCollapsed":false,"position":{"x":-58.8513755706307,"y":19.17698925165986}},"type":"3"}],"data":{"inputs":{"batchSize":{"type":"integer","value":{"content":"100","type":"literal"}},"concurrentSize":{"type":"integer","value":{"content":"3","type":"literal"}},"inputParameters":[{"input":{"schema":{"type":"string"},"type":"list","value":{"content":{"blockID":"122935","name":"content","source":"block-output"},"rawMeta":{"type":99},"type":"ref"}},"name":"input"}]},"nodeMeta":{"description":"通过设定批量运行次数和逻辑，运行批处理体内的任务","icon":"https://lf3-static.bytednsdoc.com/obj/eden-cn/dvsmryvd_avi_dvsm/ljhwZthlaukjlkulzlp/icon/icon-Batch-v2.jpg","mainColor":"#00B2B2","su